{
  "appId": "com.sherouk.question-bank",
  "files": ["dist-electron", "dist-react"],
  "extraResources": ["dist-electron/preload.cjs"],
  "icon": "./university.png",
  "publish": {
    "provider": "github",
    "owner": "SheroukHesham",
    "repo": "question-bank-desktop-app"
  },
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": "AppImage",
    "category": "Utility"
  },
  "nsis": {
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "oneClick": false
  },
  "win": {
    "target": ["portable", "msi", "nsis"]
  }
}
